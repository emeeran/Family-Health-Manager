{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Health Manager Desktop",
  "version": "1.2.17",
  "identifier": "com.dawnstar.healthmanager",
  "build": {
    "frontendDist": "stub",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DAWNSTAR Family Health Keeper",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "publisher": "Family Health Manager",
    "category": "Medical",
    "shortDescription": "Self-hosted family health record manager",
    "longDescription": "Family Health Manager: AI-powered document extraction, medication tracking, and conversational health Q&A \u2014 running fully locally as a desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/health-manager-backend"
    ],
    "linux": {
      "deb": {
        "depends": [
          "tesseract-ocr",
          "ghostscript"
        ]
      }
    }
  }
}
