# ── Application ──────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
DEBUG=true

# Dedicated Fernet key for encrypting files & 2FA secrets at rest. Leave empty in
# dev to auto-derive from SECRET_KEY; MUST be set in production (the .deb install
# generates one). Kept separate from SECRET_KEY so JWT-key rotation never renders
# encrypted files unrecoverable.
ENCRYPTION_KEY=

# Shared secret protecting GET /health/detail. Leave empty in dev to auto-derive
# from SECRET_KEY[:16]; MUST be set in production.
HEALTH_CHECK_SECRET=

# ── Database ─────────────────────────────────────────────
# SQLite (dev default). PostgreSQL is also supported for production.
DATABASE_URL=sqlite+aiosqlite:///./data/health.db

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Redis (optional) ─────────────────────────────────────
# Leave empty for the in-memory fallback (dev). Set for multi-worker deployments
# so rate limiting and the insight cache are shared across workers.
# REDIS_URL=redis://localhost:6379/0

# ── AI Providers (at least one recommended) ──────────────
# Local Ollama (no API key needed, runs on your machine). Model names MUST match
# a model pulled on the host (`ollama list`). The app defaults to qwen3:4b;
# pull it with `ollama pull qwen3:4b` and pin the tag explicitly so Ollama
# doesn't look for a missing :latest tag.
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEXT_MODEL=qwen3:4b

# Cloud providers (optional fallbacks if Ollama is unavailable):
#OPENAI_API_KEY=sk-...
#GEMINI_API_KEY=AIza...
#GROQ_API_KEY=gsk_...
#OPENROUTER_API_KEY=sk-or-v1-...

# ── AI / extraction performance (optional, sensible defaults) ─────────────
# Provider selection: the household "primary provider" defaults to "auto" —
# cloud-first when any cloud key is set, else local (Ollama). Override per
# household in Settings, or force it here is not supported (it's a household
# setting). See docs/07-deployment/deployment.md → "Performance tuning".
#
# How long Ollama keeps the model resident after a call. 30m avoids repeated
# ~9s CPU cold-loads on back-to-back extractions (costs ~3 GB RAM while alive).
OLLAMA_KEEP_ALIVE=30m
# Fire one throwaway generation per Ollama model at startup so the first user
# extraction isn't a cold load. Runs as a non-blocking background task.
OLLAMA_WARMUP_ON_STARTUP=true
# Faster/smaller Ollama model for clean-text extraction (text path only). Empty
# = off (use OLLAMA_TEXT_MODEL). EVAL-GATED: validate accuracy with
# `cd backend && uv run python -m tests.extraction.evaluator --real-ai` first.
OLLAMA_FAST_MODEL=
# Cloud provider extraction is abandoned after this many seconds (dead/slow key
# → try the next provider). Local Ollama gets the larger EXTRACTION_LOCAL_TIMEOUT.
EXTRACTION_PROVIDER_TIMEOUT=15
EXTRACTION_LOCAL_TIMEOUT=300
# Race healthy cloud providers in parallel (first non-empty wins) instead of
# sequential failover. Off by default — the pre-flight health probe already
# removes the dead-key wait, and racing burns calls on losing providers.
EXTRACTION_RACE_PROVIDERS=false
# Pages of OCR text packed into one extraction call (larger = fewer calls).
EXTRACTION_PAGES_PER_CHUNK=5
# Page images sent in ONE multi-image vision call (larger = fewer calls). 1
# disables multi-image (legacy one-call-per-page).
EXTRACTION_VISION_BATCH_SIZE=3
# Max concurrent vision batch calls (cloud path). Capped to avoid rate limits.
EXTRACTION_VISION_BATCH_CONCURRENCY=4
# Longest-side cap (px) for raw image uploads before they become a vision
# payload (phone photos are ~4000px). 1568 = OpenAI high-detail tile boundary.
# 0 disables (sends the original bytes). PDF pages are already DPI-bounded.
EXTRACTION_VISION_MAX_DIM=1568
# Soft cap on generated tokens for cloud EXTRACTION calls (text + vision).
# 4096 = 2x the proven-local cap (headroom so dense extractions aren't truncated
# mid-JSON → accuracy). If data_rate in /ai/extraction-metrics drops, raise or
# set 0 to disable. Ollama uses num_predict; OCR/transcription are uncapped.
EXTRACTION_MAX_TOKENS=4096

# ── Storage ──────────────────────────────────────────────
STORAGE_PATH=./data/attachments
