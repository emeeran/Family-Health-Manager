# Health Manager Configuration
# Edit this file to customize your installation.

# Application environment
# "production" enforces hardening (DEBUG off, docs/OpenAPI disabled,
# HEALTH_CHECK_SECRET required). SQLite is fine for a single-server production
# deployment. This is a packaged install, so the default is production.
APP_ENV=production

# Secret key for JWT signing — auto-generated on first install
SECRET_KEY=<generate-secret-key>

# Dedicated Fernet key for encrypting files & 2FA secrets at rest. Kept separate
# from SECRET_KEY so rotating the JWT signing key never renders encrypted files
# unrecoverable. Auto-generated on first install (and on upgrade if absent).
ENCRYPTION_KEY=<generate-encryption-key>

# Secret for the authenticated /health/detail endpoint — auto-generated on first
# install. Required when APP_ENV=production (startup refuses without it).
HEALTH_CHECK_SECRET=<generate-health-secret>

# Database URL
# SQLite (default — stores in /var/lib/health-manager/data/). SQLite is fine for
# a single-server production deployment (WAL mode + foreign keys enabled):
DATABASE_URL=sqlite+aiosqlite:////var/lib/health-manager/data/health.db
# PostgreSQL (optional, for multi-worker or larger deployments):
# DATABASE_URL=postgresql+asyncpg://healthmgr:password@localhost:5432/healthmanager

# File storage path (attachments, backups)
STORAGE_PATH=/var/lib/health-manager/data/attachments

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8080

# External port for Caddy to listen on
PORT=8080

# Max request body sizes (MB), tiered by request path:
#   MAX_REQUEST_SIZE_MB — general API JSON (keep small)
#   MAX_UPLOAD_SIZE_MB  — file uploads (document extract-batch, attachments).
#                         Raise this if you extract large scanned PDFs or big
#                         batches (the extract endpoint accepts up to 20 files
#                         per request). Edit then restart health-manager.service.
#   MAX_BACKUP_SIZE_MB  — backup restore
MAX_REQUEST_SIZE_MB=50
MAX_UPLOAD_SIZE_MB=500
MAX_BACKUP_SIZE_MB=500

# Redis URL (leave empty for in-memory fallback)
REDIS_URL=

# Run background scheduler (reminders, backups, etc.)
RUN_SCHEDULER=true

# AI provider (optional — leave empty to disable AI features)
# Model names MUST match a model pulled on the host (`ollama list`). The default
# install pulls qwen3:4b; pin the tag explicitly so Ollama doesn't look for a
# :latest tag that isn't present.
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEXT_MODEL=qwen3:4b

# ── AI / extraction performance knobs (defaults are sensible) ─────────────
# Provider selection: a household's "primary provider" defaults to "auto" —
# cloud-first when any cloud key (below) is set, else local (Ollama). So adding
# any cloud key makes extraction ~30-60x faster with no other change. Cloud keys
# are set per-household in the Settings UI (not here). See deployment.md
# → "Performance tuning" for the full picture.
#
# How long Ollama keeps the model resident after a call. 30m avoids repeated
# ~9s CPU cold-loads on back-to-back extractions (costs ~3 GB RAM while alive).
OLLAMA_KEEP_ALIVE=30m
# Fire one throwaway generation per Ollama model at startup so the first user
# extraction isn't a cold load. Non-blocking (doesn't delay app readiness).
OLLAMA_WARMUP_ON_STARTUP=true
# Faster/smaller Ollama model for clean-text extraction (text path only). Empty
# = off. EVAL-GATED: validate accuracy before enabling in prod.
OLLAMA_FAST_MODEL=
# Cloud provider extraction is abandoned after this many seconds (dead/slow key
# → try the next provider). Local Ollama gets the larger EXTRACTION_LOCAL_TIMEOUT.
EXTRACTION_PROVIDER_TIMEOUT=15
EXTRACTION_LOCAL_TIMEOUT=300
# Race healthy cloud providers in parallel (first non-empty wins). Off by
# default — the pre-flight health probe already prunes dead keys from the chain
# (no 15s dead-key wait), and racing burns calls on losing providers.
EXTRACTION_RACE_PROVIDERS=false
# Pages of OCR text packed into one extraction call; page images per multi-image
# vision call. Larger = fewer LLM calls on multi-page scans (Ollama serializes,
# so each call saved is ~1-2 min on CPU).
EXTRACTION_PAGES_PER_CHUNK=5
EXTRACTION_VISION_BATCH_SIZE=3
EXTRACTION_VISION_BATCH_CONCURRENCY=4
# Longest-side cap (px) for raw image uploads before vision (0 disables).
EXTRACTION_VISION_MAX_DIM=1568
# Cloud extraction generation cap (tokens). 0 disables.
EXTRACTION_MAX_TOKENS=4096

# Cloud AI providers (optional — also settable per-household in the Settings UI):
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#GROQ_API_KEY=
#OPENROUTER_API_KEY=
