#!/bin/bash
set -e

# Post-install script for health-manager

# Ensure an external CLI dependency the app shells out to is installed. The deb
# declares these via Depends: (which `apt install ./file.deb` resolves), but a
# bare `dpkg -i` does NOT resolve dependencies — so install defensively here to
# keep the app fully functional regardless of install method. Graceful: if apt
# is unavailable or offline, warn but never fail the install (the app degrades
# cleanly without these binaries).
ensure_package() {
    local pkg="$1" bin="${2:-$1}"
    if command -v "$bin" >/dev/null 2>&1; then
        return 0
    fi
    echo "health-manager: '$bin' not found — installing $pkg..."
    if command -v apt-get >/dev/null 2>&1; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq >/dev/null 2>&1 || true
        if apt-get install -y --no-install-recommends "$pkg"; then
            echo "health-manager: $pkg installed."
        else
            echo "health-manager: WARNING — could not install $pkg automatically (offline or apt error)." >&2
            echo "                 Install it manually: sudo apt-get install $pkg" >&2
        fi
    else
        echo "health-manager: WARNING — apt-get unavailable; cannot auto-install $pkg." >&2
        echo "                 The app needs $pkg. Install it via your package manager." >&2
    fi
}

case "$1" in
    configure)
        # tesseract-ocr: required for OCR of scanned PDFs/images. Without it,
        # scanned-document extraction fails with "no readable data found in
        # document" (the app skips OCR and falls back to vision AI).
        ensure_package tesseract-ocr tesseract

        # ghostscript: used to downsample/optimize scanned PDFs on ingest so
        # attachments stay small. The app degrades gracefully (stores the PDF
        # unoptimized) if absent, but install it so the optimization path works.
        ensure_package ghostscript gs

        # Create health-manager system user if it doesn't exist
        if ! id -u health-manager &>/dev/null; then
            useradd --system --no-create-home --shell /usr/sbin/nologin \
                --comment "Health Manager Service" health-manager
        fi

        # Create data directories
        mkdir -p /var/lib/health-manager/data/attachments
        mkdir -p /var/lib/health-manager/data/backups
        chown -R health-manager:health-manager /var/lib/health-manager

        # Create log directory
        mkdir -p /var/log/health-manager
        chown -R health-manager:health-manager /var/log/health-manager

        # Set ownership on installed files
        chown -R health-manager:health-manager /opt/health-manager

        # Create symlink so relative paths in the codebase resolve
        # to the persistent data directory:
        #   ./data/health.db      → /var/lib/health-manager/data/health.db
        #   ./data/scheduler.db   → /var/lib/health-manager/data/scheduler.db
        #   ./data/attachments/   → /var/lib/health-manager/data/attachments/
        #   ./data/backups/       → /var/lib/health-manager/data/backups/
        rm -f /opt/health-manager/backend/data
        ln -s /var/lib/health-manager/data /opt/health-manager/backend/data
        chown -h health-manager:health-manager /opt/health-manager/backend/data

        # Generate SECRET_KEY if its placeholder is present (new install)
        if grep -q '<generate-secret-key>' /etc/health-manager/config.env; then
            SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_urlsafe(48))")
            sed -i "s|<generate-secret-key>|${SECRET_KEY}|" /etc/health-manager/config.env
        fi

        # Generate ENCRYPTION_KEY (Fernet key: 32 random bytes, urlsafe-b64).
        # New install: replace the placeholder. Upgrade of an existing install:
        # the line is absent (config.env is a preserved dpkg conffile) → append.
        if grep -q '<generate-encryption-key>' /etc/health-manager/config.env; then
            ENC_KEY=$(python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
            sed -i "s|<generate-encryption-key>|${ENC_KEY}|" /etc/health-manager/config.env
        elif ! grep -qE '^ENCRYPTION_KEY=' /etc/health-manager/config.env; then
            ENC_KEY=$(python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
            echo "ENCRYPTION_KEY=${ENC_KEY}" >> /etc/health-manager/config.env
        fi

        chmod 600 /etc/health-manager/config.env
        chown health-manager:health-manager /etc/health-manager/config.env

        # Make caddy binary executable
        chmod +x /opt/health-manager/caddy

        # Update desktop icon cache
        gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
        update-desktop-database /usr/share/applications 2>/dev/null || true

        # Reload systemd daemon
        systemctl daemon-reload

        # Enable and start services
        systemctl enable health-manager.service
        systemctl enable health-manager-caddy.service
        systemctl start health-manager.service || echo "WARNING: health-manager.service failed to start. Check: journalctl -eu health-manager.service"
        systemctl start health-manager-caddy.service || echo "WARNING: health-manager-caddy.service failed to start. Check: journalctl -eu health-manager-caddy.service"

        # Disaster-recovery restore trigger: the path unit watches for a
        # restore-request flag file written by the app, then runs the root
        # restore helper. Enable + start only the path unit (the service is
        # triggered on demand; not started at boot).
        chmod 755 /opt/health-manager/restore-archive.sh
        systemctl enable health-manager-restore.path
        systemctl start health-manager-restore.path || echo "WARNING: health-manager-restore.path failed to start. One-click restore will be unavailable."
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        ;;
esac

exit 0
